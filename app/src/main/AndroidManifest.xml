<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading the Kokoro voice pack (once). Reading itself works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Reading controls in the quick panel and on the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- To open Good Lock's gesture modules from the setup screen. -->
    <queries>
        <package android:name="com.samsung.android.goodlock" />
        <package android:name="com.samsung.android.sidegesturepad" />
        <package android:name="com.samsung.android.app.galaxyregistry" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yomiage"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Reads the app underneath and closes at once. Its launcher entry ("Read My Screen") is what
             "Hey Google, open Read My Screen" and a side-button double press can open. -->
        <activity
            android:name=".ReadScreenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_my_screen"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="dev.yomiage.READ_SCREEN" />
                <action android:name="dev.yomiage.TAP_TO_READ" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Second launcher entry for tap-to-start, off until turned on in the app. -->
        <activity-alias
            android:name=".TapToReadLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tap_screen"
            android:label="@string/tap_to_read"
            android:targetActivity=".ReadScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Add shortcut" for gesture apps and launchers. -->
        <activity
            android:name=".CreateShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_read_screen"
            android:label="@string/yomiage_shortcut"
            android:theme="@style/Theme.Yomiage.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- See-through, untouchable window that keeps Yomiage "in front" while on-device AI thinks. -->
        <activity
            android:name=".ai.AiHostActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:taskAffinity="dev.yomiage.aihost"
            android:theme="@style/Theme.Yomiage.Invisible" />

        <!-- Tapping the media controls brings the player back. -->
        <activity
            android:name=".media.ShowPlayerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".media.MediaActionReceiver"
            android:exported="false" />

        <activity-alias
            android:name=".ReadScreenLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_read_screen"
            android:label="@string/read_my_screen"
            android:targetActivity=".ReadScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Read aloud" in the text-selection menu and the share sheet. -->
        <activity
            android:name=".ReadTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_aloud"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.ReadTileService"
            android:exported="true"
            android:icon="@drawable/ic_lines"
            android:label="@string/tile_read"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.TapTileService"
            android:exported="true"
            android:icon="@drawable/ic_tap"
            android:label="@string/tile_tap"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ReaderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
